# ===== Gurita Panel Configuration =====
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# Ganti dengan string acak 64+ karakter sebelum production
SESSION_SECRET=KHYCdlyoy3OYlSiqVg0MUjIiS2D4v3VYilgZcpgmK6BW9JkQv6ZB1iIEhutzLWLQ

# Path
DATABASE_PATH=./database
STORAGE_PATH=./storage
SERVER_ROOT=./storage/servers
BACKUP_ROOT=./storage/backups
LOG_ROOT=./storage/logs

# Session
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=gurita_sid

# Registration
ALLOW_REGISTRATION=false

# Security
TRUST_PROXY=false
LOGIN_RATE_WINDOW_MIN=10
LOGIN_RATE_MAX_ATTEMPTS=8

# Resource enforcement
ENABLE_CGROUPS=true
CGROUP_ROOT=/sys/fs/cgroup/gurita-panel

# Process supervision
SYSTEMD_AVAILABLE=auto